# URL yang dipakai Prisma untuk terhubung ke MySQL.
DATABASE_URL="mysql://tourify_admin:replace-with-a-local-password@localhost:3306/tourify"
# Secret dan alamat server yang dipakai Better Auth.
BETTER_AUTH_SECRET="generate-a-random-secret-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"
# Kredensial dan nama database untuk container di docker-compose.yml.
MYSQL_ROOT_PASSWORD="replace-with-a-root-password"
MYSQL_USER="tourify_admin"
MYSQL_PASSWORD="replace-with-a-local-password"
MYSQL_DATABASE="tourify"
